{
  "name": "trainings-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "serve": "npx --yes http-server -p 8787 -c-1 .",
    "gas:push": "clasp push --force",
    "gas:deploy": "clasp push --force && clasp update-deployment $(node -p \"require('./.clasp.json').deploymentId\") -d \"Update aus Claude Code\""
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "lucide-react": "1.55.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "esbuild": "0.28.2",
    "tailwindcss": "3.4.19"
  }
}
